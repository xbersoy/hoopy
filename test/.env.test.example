# Copy this file to .env.test and fill in the values.
# Create a test database: createdb hoopy_test

# Test Database (Postgres)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoopy_test

# JWT (used by E2E tests)
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
ACCESS_TOKEN_EXPIRATION_TIME=1h
REFRESH_TOKEN_EXPIRATION_TIME=7d

# Storage (mocked in tests, but listed for completeness)
SUPABASE_URL=https://test.supabase.co
SUPABASE_KEY=test-key
SUPABASE_BUCKET=hoopy-test
