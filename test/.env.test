DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_DATABASE=hoopy_test

# Application config
ENV=test
PORT=3001
HOST=0.0.0.0
ENABLE_SWAGGER=0

# Database URL used by TypeORM app config (tests can reuse same DB)
DATABASE_URL=postgres://test:test@localhost:5432/hoopy_test
DATABASE_SYNCHRONIZE=1
DATABASE_DROP_SCHEMA=1

# JWT settings used by both config module and tests
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
ACCESS_TOKEN_EXPIRATION_TIME=15m
REFRESH_TOKEN_EXPIRATION_TIME=7d
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# Redis (not strictly required for all tests, but defined for completeness)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Supabase (dummy values for tests; can be overridden in CI)
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
SUPABASE_BUCKET=hoopy